# If a file called .chezmoi.$FORMAT.tmpl exists in the root of the source state
# then chezmoi init will use it to create or update the chezmoi config file. 
# $FORMAT must be one of the supported config file formats.
# This template differs from source state templates because this template is executed prior to the reading of the source state.

# Rendered to ~/.config/chezmoi/chezmoi.toml

{{- /* Explicit machine profile; never inferred from OS, hostname, or email.
       Asked once, then preserved. To change it: chezmoi init --prompt */}}
{{- $profile := promptChoiceOnce . "profile" "Machine profile" (list "work" "personal") }}
{{- $agentChoices := list "claude" "codex" "amp" }}
{{- $agentData := . }}
{{- /* Seed only a missing selection; the native once-prompt still honors --prompt. */}}
{{- if not (hasKey . "agents") }}
{{-   $installed := list }}
{{-   range $agentChoices }}
{{-     if lookPath . }}
{{-       $installed = append $installed . }}
{{-     end }}
{{-   end }}
{{-   if $installed }}
{{-     $agentData = dict "agents" $installed }}
{{-   end }}
{{- end }}
{{- $agents := promptMultichoiceOnce $agentData "agents" "Coding agents to install" $agentChoices $agentChoices }}
{{- /* Context checkout for this profile. Missing context is reported, never
       replaced with the other profile's checkout. */}}
{{- $contextRoot := joinPath .chezmoi.homeDir "src/0x00101010/workspace" }}
{{- if eq $profile "work" }}
{{-   $contextRoot = joinPath .chezmoi.homeDir "src/0x00101010/coinbase" }}
{{- end }}

[source]
  # Default is fine; keep explicit for clarity
  directory = "{{ .chezmoi.sourceDir }}"

[edit]
  command = "code"

[data]
  email = {{ promptStringOnce . "email" "What is your email address" | quote }}
  fullName = {{ promptStringOnce . "fullName" "What is your name" | quote }}
  signingkey = {{ promptStringOnce . "signingkey" "What is your GPG signing key" | quote }}
  profile = {{ $profile | quote }}
  agents = {{ $agents | toToml }}
  contextRoot = {{ $contextRoot | quote }}

[secret]
  # Optional: enable if you use 1Password CLI (op)
  command = "op"
