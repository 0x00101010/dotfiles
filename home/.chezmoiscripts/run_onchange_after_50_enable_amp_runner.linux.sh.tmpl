#!/usr/bin/env bash
# Keep the Amp runner running across logouts and reboots. Reruns when the unit changes.
# unit: {{ include "dot_config/systemd/user/amp-runner.service" | sha256sum }}
set -euo pipefail

{{- if has "amp" .agents }}

command -v systemctl >/dev/null || { echo "[chezmoi] systemctl not found; amp runner is not enabled" >&2; exit 0; }
systemctl --user daemon-reload
systemctl --user enable --quiet amp-runner.service
if systemctl --user is-active --quiet amp-runner.service; then
  echo "[chezmoi] amp-runner.service changed; restart it when no thread is running: systemctl --user restart amp-runner" >&2
else
  systemctl --user start amp-runner.service
  echo "[chezmoi] Started amp-runner.service (runner id: $(hostname))"
fi
loginctl enable-linger "$USER" 2>/dev/null \
  || echo "[chezmoi] loginctl enable-linger failed; run 'sudo loginctl enable-linger $USER' so the runner starts at boot" >&2
{{- end }}
