{{- $agents := get . "agents" | default list -}}
{{- if or (not (has "claude" $agents)) (and (env "CLAUDE_CONFIG_DIR") (ne (env "CLAUDE_CONFIG_DIR") (joinPath .chezmoi.homeDir ".claude"))) }}
.claude
{{- end }}
{{- if or (not (has "codex" $agents)) (and (env "CODEX_HOME") (ne (env "CODEX_HOME") (joinPath .chezmoi.homeDir ".codex"))) }}
.codex
{{- end }}
{{- if not (or (has "codex" $agents) (has "amp" $agents) (has "pi" $agents)) }}
.agents/skills/pr
.agents/skills/recap
.agents/skills/plan
.agents/skills/execute-plan
.agents/skills/agent-browser
.agents/skills/beautiful-mermaid
.agents/skills/check
.agents/skills/docs
.agents/skills/loop
.agents/skills/notify
.agents/skills/review
.agents/skills/simplify
.agents/skills/workspace
.agents/skills/work-planner
{{- end }}
{{- if not (has "pi" $agents) }}
.pi
{{- end }}
{{- if not (has "amp" $agents) }}
.config/amp/AGENTS.md
.config/amp/plugins/pr-review.ts
{{- end }}
{{- if not (or (has "claude" $agents) (has "codex" $agents) (has "amp" $agents) (has "pi" $agents)) }}
.agents/skills/_shared
.local/bin/devslot
.local/bin/skillsync
{{- end }}
